      <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
